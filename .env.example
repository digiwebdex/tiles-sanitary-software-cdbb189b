# Supabase Configuration (managed by Lovable Cloud)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key-here
VITE_SUPABASE_PROJECT_ID=your-project-id

# NOTE: DATABASE_URL, JWT_SECRET, and other server-side secrets
# are managed automatically by Lovable Cloud and should NOT be
# added here. They are configured in the backend environment.

# ─── VPS Migration toggles ─────────────────────────────────────────────
# Production custom domains default to VPS auth. Keep this set on the VPS build
# so /login uses https://api.sanitileserp.com/api/auth/login, not legacy auth.
VITE_AUTH_BACKEND=vps
VITE_VPS_API_BASE=https://api.sanitileserp.com

# Phase 6 — portal data path (default supabase until portal auth cutover)
# VITE_PORTAL_BACKEND=vps

# Phase 6 — GL spine (backend only; requires USE_POSTING_ENGINE=true)
# USE_GL_SPINE=true
#   supabase | shadow | vps
# Default for every resource is supabase (no behavior change).
#
# Phase 3B — Suppliers shadow mode:
# VITE_DATA_SUPPLIERS=shadow
#
# Phase 3C — Customers shadow mode:
# VITE_DATA_CUSTOMERS=shadow
#
# Phase 3D — Products + Stock + Batches shadow mode:
# VITE_DATA_PRODUCTS=shadow
# VITE_DATA_STOCK=shadow
# VITE_DATA_BATCHES=shadow
#
# Other resources MUST stay on supabase until their own phase begins.
# VITE_DATA_SALES=supabase
# VITE_DATA_QUOTATIONS=supabase
# VITE_DATA_DELIVERIES=supabase
# VITE_DATA_PURCHASES=supabase

# Self-hosted backend base URL (used by vpsAdapter + authBridge)
# VITE_VPS_API_BASE=https://api.sanitileserp.com

# ─── Notification channels (backend) ───────────────────────────────────
# SMS via BulkSMSBD
# BULKSMSBD_API_KEY=your-api-key
# BULKSMSBD_SENDER_ID=your-sender-id
# BULKSMSBD_API_URL=http://bulksmsbd.net/api/smsapi
#
# WhatsApp via WasenderAPI (https://wasenderapi.com) — token is the per-session
# Bearer key from the Credentials tab. Keep the real value in .env only.
# WASENDER_API_URL=https://wasenderapi.com/api/send-message
# WASENDER_API_TOKEN=your-wasender-bearer-token
#
# Email via SMTP (e.g. Gmail needs a 16-char App Password, not your login)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=digiwebdex@gmail.com
# SMTP_PASS=your-16-char-app-password
# SMTP_FROM="Tiles & Sanitary ERP <digiwebdex@gmail.com>"
